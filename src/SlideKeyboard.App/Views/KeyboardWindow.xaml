<Window x:Class="SlideKeyboard.App.Views.KeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SlideKeyboard.App.Controls"
        Title="Slide Keyboard"
        WindowStyle="None" Background="{DynamicResource Kb.Background}"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        Focusable="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}"
        Width="900" Height="380">
    <!-- A normal (non-layered) window: Windows 11 rounds its corners and draws the border, see OnSourceInitialized.
         Transparent WPF windows are composed on the CPU and render incompletely on some GPU drivers. -->
    <Grid x:Name="Chrome">
        <Border x:Name="Body" Background="{DynamicResource Kb.Background}"
                BorderBrush="{DynamicResource Kb.Border}" BorderThickness="1" Padding="8,2,8,2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="SuggestionRow" Height="42"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition x:Name="ToolbarRow" Height="36"/>
                </Grid.RowDefinitions>

                <Grid x:Name="SuggestionBar" Grid.Row="0" Margin="2,0"/>

                <controls:KeyboardSurface x:Name="Surface" Grid.Row="1" Panel.ZIndex="10" Margin="0,2"/>

                <Grid x:Name="Toolbar" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="DragGrip" Grid.Column="0" Background="Transparent" Width="40" Cursor="SizeAll"
                            ToolTip="Drag to move the keyboard">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE76F;" Foreground="{DynamicResource Kb.SubText}"/>
                    </Border>

                    <Button x:Name="LanguageButton" Grid.Column="1" Style="{StaticResource ToolButton}" Click="OnLanguageClick"
                            ToolTip="Switch language (Ctrl+Space)">
                        <StackPanel x:Name="LanguagePanel" Orientation="Horizontal"/>
                    </Button>

                    <Border x:Name="DragArea" Grid.Column="2" Background="Transparent" Cursor="SizeAll"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,14,0">
                        <Button x:Name="ModeButton" Style="{StaticResource ToolButton}" Click="OnModeClick" ToolTip="Compact / full keyboard">
                            <TextBlock x:Name="ModeIcon" Style="{StaticResource IconText}" Text="&#xE73F;"/>
                        </Button>
                        <Button x:Name="ThemeButton" Style="{StaticResource ToolButton}" Click="OnThemeClick" ToolTip="Light / dark theme">
                            <TextBlock x:Name="ThemeIcon" Style="{StaticResource IconText}" Text="&#xE708;"/>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Click="OnSettingsClick" ToolTip="Settings">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE713;"/>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Click="OnMinimizeClick" ToolTip="Minimize (Ctrl+Alt+K)">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE921;"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Thumb x:Name="ResizeGrip" Grid.Row="2" Style="{StaticResource ResizeGripStyle}" Width="18" Height="18"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,0"
                       DragDelta="OnResizeDelta" DragCompleted="OnResizeCompleted" ToolTip="Drag to resize"/>
            </Grid>
        </Border>
    </Grid>
</Window>
