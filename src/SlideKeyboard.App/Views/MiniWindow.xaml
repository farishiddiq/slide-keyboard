<Window x:Class="SlideKeyboard.App.Views.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slide Keyboard"
        WindowStyle="None" Background="{DynamicResource Kb.Accent}"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        Focusable="False" Width="52" Height="52">
    <Grid>
        <Border x:Name="Bubble" Background="Transparent" Cursor="Hand" ToolTip="Show keyboard (Ctrl+Alt+K)">
            <TextBlock Style="{StaticResource IconText}" Text="&#xE765;" FontSize="22" Foreground="{DynamicResource Kb.AccentText}"/>
        </Border>
    </Grid>
</Window>
