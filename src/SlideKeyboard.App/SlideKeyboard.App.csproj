<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SlideKeyboard</AssemblyName>
    <RootNamespace>SlideKeyboard.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Slide Keyboard</Product>
    <Version>1.0.0</Version>
    <Company>farishiddiq</Company>
    <Copyright>Copyright (c) 2026 farishiddiq</Copyright>
    <!-- WPF reads DPI awareness from app.manifest; this WinForms analyzer does not apply. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SlideKeyboard.Core\SlideKeyboard.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <None Include="..\..\dictionaries\**\*.*" LinkBase="dictionaries" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
