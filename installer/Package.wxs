<!--
  Slide Keyboard MSI (WiX Toolset 5). Per-user install: no administrator rights needed.
  Build with installer/build.ps1, which publishes the self-contained app first.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Slide Keyboard"
           Manufacturer="farishiddiq"
           Version="$(var.Version)"
           UpgradeCode="6C1D9F64-2B77-4C1A-9E3D-5A8B1F0C7E21"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Slide Keyboard is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="..\src\SlideKeyboard.App\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/farishiddiq/slide-keyboard" />
    <Property Id="ARPHELPLINK" Value="https://github.com/farishiddiq/slide-keyboard/issues" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />
    <ui:WixUI Id="WixUI_Minimal" />

    <!-- %LocalAppData%\Programs\Slide Keyboard: the standard per-user program location (no admin rights). -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Slide Keyboard" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="Slide Keyboard">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="Shortcuts" />
      <ComponentRef Id="Cleanup" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="Shortcuts" Guid="B2E4C7A1-5D3F-4E8B-9C6A-1F2D3E4A5B6C">
        <Shortcut Id="StartMenuShortcut" Name="Slide Keyboard" Description="Swipe-to-type on-screen keyboard"
                  Target="[INSTALLFOLDER]SlideKeyboard.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="Slide Keyboard" Description="Swipe-to-type on-screen keyboard"
                  Target="[INSTALLFOLDER]SlideKeyboard.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\SlideKeyboard" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="Cleanup" Guid="C3F5D8B2-6E4A-4F9C-8D7B-2A3E4F5B6C7D">
        <RegistryValue Root="HKCU" Key="Software\SlideKeyboard" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      </Component>
    </DirectoryRef>

    <!-- On uninstall, close a running keyboard and remove its "Start with Windows" entry (if the user enabled it).
         Settings and the personal dictionary in %AppData%\SlideKeyboard are kept. -->
    <CustomAction Id="CloseRunningApp" Directory="INSTALLFOLDER" Execute="immediate" Return="ignore"
                  ExeCommand="&quot;[SystemFolder]taskkill.exe&quot; /IM SlideKeyboard.exe /F" />
    <CustomAction Id="RemoveStartupEntry" Directory="INSTALLFOLDER" Execute="immediate" Return="ignore"
                  ExeCommand="&quot;[SystemFolder]reg.exe&quot; delete &quot;HKCU\Software\Microsoft\Windows\CurrentVersion\Run&quot; /v SlideKeyboard /f" />
    <InstallExecuteSequence>
      <Custom Action="CloseRunningApp" Before="InstallValidate" Condition="Installed" />
      <Custom Action="RemoveStartupEntry" After="CloseRunningApp" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
